FROM NODES AS N
INNER JOIN Engines e ON e.EngineID = n.EngineID
WHERE ObjectSubType&lt;&gt;'ICMP'
AND DATEDIFF(minute, LastSystemUptimePollUtc, GETUTCDATE())&gt;(StatCollection*3)
AND STATUS NOT IN (2,9,11)
ORDER BY LastSystemUptimePollUtc ASC
</a:CommandText><a:CommandTextSignature>rnz6HYQFRG+QiUzQovpRtJNcfFiNMES16/rY6DWf8FDbMOJZ9AxtreBgiN9cElr7cx1wMZi8M7/l4bZ0SXslyw==</a:CommandTextSignature><a:DynamicSelectionType>Undefined</a:DynamicSelectionType><a:EntityUri xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"/><a:Filter i:nil="true"/><a:MasterEntity>Orion.Nodes</a:MasterEntity><a:Name>Nodes Datasource</a:Name><a:NetObjectId/><a:RefId>33a621bb-db5d-4f21-b823-476c409fd17f</a:RefId><a:Type>CustomSQL</a:Type></a:DataSource><a:DataSource><a:CommandText>SELECT
c.NodeID
,c.Node.Caption AS [Caption]
,c.Node.Status
,c.Node.ChildStatus
,'/Orion/images/StatusIcons/Small-' + c.Node.StatusIcon AS [_IconFor_Caption]
,c.Node.DetailsURL AS [DetailsURL]
,c.Node.Vendor AS [Vendor]
,c.Node.MachineType AS [Machine Type]
,C.Node.SNMPVersion
,CASE
    WHEN c.Username IS NULL THEN c.Node.Community
    ELSE c.Username END AS [v2-Community-v3-Username]
,c.AuthenticationMethod AS [v3 Auth Method]
,c.PrivacyMethod AS [v3 Priv Method]
,c.Node.CustomProperties.LocationType AS [LocationType]
,c.Node.CustomProperties.Team AS [Team]
FROM Orion.SNMPv3Credentials c
WHERE c.Node.SNMPVersion != '0'
ORDER BY c.Node.Caption ASC</a:CommandText><a:DynamicSelectionType>Undefined</a:DynamicSelectionType><a:EntityUri xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"/><a:Filter i:nil="true"/><a:MasterEntity>Orion.Nodes</a:MasterEntity><a:Name>SNMP_Credentials</a:Name><a:NetObjectId/><a:RefId>0b300bb2-98c6-458c-9636-de615bfb856c</a:RefId><a:Type>CustomSWQL</a:Type></a:DataSource></DataSources><Description>Displays a table of all SNMP Polled Nodes with either the SNMPv2 Community String or the SNMPv3 Username, Authentication Method and Encryption Method.</Description><Footer xmlns:a="http://schemas.datacontract.org/2004/07/SolarWinds.Reporting.Models.Layout"><a:CustomText>Confidential</a:CustomText><a:ShowCustomText>true</a:ShowCustomText><a:ShowPageNumber>true</a:ShowPageNumber><a:ShowTimestamp>true</a:ShowTimestamp><a:Visible>true</a:Visible></Footer><Header xmlns:a="http://schemas.datacontract.org/2004/07/SolarWinds.Reporting.Models.Layout"><a:Logo/><a:SubTitle>Reports on SNMPv2 Community or SNMPv3 Username</a:SubTitle><a:Title>SNMP Credentials [Per Node]</a:Title><a:Visible>true</a:Visible></Header><LicenseFeatureName i:nil="true"/><LimitationCategory>RBS - Default Reports</LimitationCategory><ModuleTitle i:nil="true"/><Name>SNMP Credentials [Per Node]</Name><OrionFeatureName i:nil="true"/><PageLayout xmlns:a="http://schemas.datacontract.org/2004/07/SolarWinds.Reporting.Models.Layout"><a:Height>0</a:Height><a:Orientation i:nil="true"/><a:PublishingType>web</a:PublishingType><a:Size i:nil="true"/><a:Units i:nil="true"/><a:Width>1400</a:Width></PageLayout><ReportGuid>ce35f0b2-a004-4607-b1c3-9a808ef3ae99</ReportGuid><Sections xmlns:a="http://schemas.datacontract.org/2004/07/SolarWinds.Reporting.Models.Layout"><a:Section><a:BorderStyle xmlns:b="http://schemas.datacontract.org/2004/07/SolarWinds.Reporting.Models.Styles"><b:Bottom i:nil="true"/><b:Color i:nil="true"/><b:Left i:nil="true"/><b:Right i:nil="true"/><b:Top i:nil="true"/></a:BorderStyle><a:Col