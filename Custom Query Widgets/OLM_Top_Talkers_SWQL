SELECT TOP 10
le.LogMessageSource.Caption,
le.LogMessageSource.IPAddress,
le.LogMessageSource.Vendor,
le.LogMessageSource.MachineType,
le.LogMessageSource.OrionNode.Engine.ServerName,
COUNT(le.MessageSourceID) AS [Count]
FROM Orion.OLM.LogEntry le
GROUP BY le.LogMessageSource.Caption, le.LogMessageSource.IPAddress, le.LogMessageSource.Vendor, le.LogMessageSource.MachineType
ORDER BY COUNT(le.MessageSourceID) DESC